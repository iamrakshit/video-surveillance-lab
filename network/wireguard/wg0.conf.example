# WireGuard server on the gateway. Copy to /etc/wireguard/wg0.conf, chmod 600, then: wg-quick up wg0
# Generate the server key once:  umask 077; wg genkey | tee /etc/wireguard/server.key | wg pubkey > /etc/wireguard/server.pub
[Interface]
Address = 10.99.0.1/24
ListenPort = 51820
PrivateKey = <contents of /etc/wireguard/server.key>

# One [Peer] block per device, generated by new-peer.sh. Example:
# [Peer]
# # phone-rakshit
# PublicKey = <client public key>
# PresharedKey = <preshared key>
# AllowedIPs = 10.99.0.2/32
